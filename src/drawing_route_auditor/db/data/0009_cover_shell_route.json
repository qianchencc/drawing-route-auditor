    {
      "op": "upsert",
      "collection": "facts",
      "key": "continuous_revolved_surface",
      "value": {
        "label": "连续回转曲面",
        "fact_key": "continuous_revolved_surface",
        "reader_key": "geometry_dimension_reader",
        "value_type": "boolean",
        "description": "当前对象是否包含需要卷制的连续圆筒、圆锥或连续圆弧壳面；折弯板展开图和折弯端部圆弧不属于此事实。",
        "source_kind": "observed_drawing",
        "hit_criteria": "主要视图或剖视图存在闭合圆、同心圆弧、圆锥母线，或直径尺寸明确绑定连续圆筒/圆锥轮廓。",
        "subject_scope": "current_object",
        "not_hit_criteria": "完整检查后仅见直边板展开轮廓、内部平行折弯线或局部折弯端部圆弧，没有连续回转壳面。",
        "coverage_requirement": "检查全部主要视图、剖视图、展开轮廓和直径尺寸所绑定的真实边界。",
        "evidence_requirement": "提供闭合圆/圆弧截面、明确直径对应轮廓或圆锥母线；仅有局部折弯端部尺寸不能作为命中证据。",
        "judgement_definition": "连续回转曲面必须由实际圆筒、圆锥或连续圆弧壳面证明。长直板轮廓内存在平行折弯线时，应按折弯展开图判断；右端局部折弯截面、圆角或形似直径符号的密集尺寸不能把整件判成回转壳体。若同时命中折弯特征，只有存在独立且明确的闭合圆/圆弧视图时才可命中本事实。"
      }
    },
