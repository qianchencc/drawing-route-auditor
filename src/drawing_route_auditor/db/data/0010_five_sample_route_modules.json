        "value_type": "boolean",
        "description": "标题栏名称是否明确包含装配、部装或总装动作语义；“部件”本身不表示装配。",
        "source_kind": "observed_drawing",
        "hit_criteria": "名称明确包含“装配”“部装”“总装”或“实配”；单独出现“部件”不得命中。",
        "subject_scope": "current_object",
        "not_hit_criteria": "名称完整可读且不包含装配、部装、总装或实配文字；仅有“部件”时返回不命中。",
        "coverage_requirement": "检查标题栏名称。",
        "evidence_requirement": "提供名称原文。",
        "judgement_definition": "逐字检查标题栏名称。必须区分“部件”和“部装”：部件是对象类型，不是装配动作。"
      }
    },
    {
      "op": "upsert",
      "collection": "facts",
      "key": "raw_form",
      "value": {
        "label": "原始形态",
        "fact_key": "raw_form",
        "reader_key": "geometry_dimension_reader",
        "value_type": "text",
        "description": "板、管、棒、铸件、锻件或其他制造前原始形态。",
        "source_kind": "observed_drawing",
        "hit_criteria": "存在材料规格、板厚、管棒截面、铸锻说明，或实心长轴类几何等足够原始形态证据。",
        "subject_scope": "current_object",
        "allowed_values": [
          "plate",
          "tube",
          "bar",
          "casting",
          "forging",
          "other"
        ],
        "not_hit_criteria": null,
        "coverage_requirement": "检查材料规格、全部主要视图、轴向长度、内外径和壁厚。",
        "evidence_requirement": "提供材料规格、板厚、内外径、实心/空心截面或铸锻说明。",
        "judgement_definition": "判断制造前原材料形态，而不是最终成品几何。均匀薄壁卷制圆筒、圆锥和壳体归一化为 plate；具有长直实心轴类轮廓、以外径和轴向长度为主且没有管壁/空腔证据时归一化为 bar，即使标题栏只给出合金牌号。"
      }
    },
