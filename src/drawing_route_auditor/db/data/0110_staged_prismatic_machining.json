{
  "schema_version": 1,
  "tree_key": "drawing-process-tree",
  "description": "由图面明确区分的粗加工、精加工/攻丝和最终外形加工标注生成可审计的多阶段棱柱加工路线，并以关键配合公差与基准形位公差的组合触发专项检验。",
  "operations": [
    {
      "op": "upsert",
      "collection": "facts",
      "key": "staged_prismatic_machining_annotations_present",
      "value": {
        "label": "多阶段棱柱加工标注",
        "fact_key": "staged_prismatic_machining_annotations_present",
        "reader_key": "requirement_annotation_reader",
        "value_type": "boolean",
        "description": "图面是否在不同视图或独立文字区域同时明确区分粗加工状态、精加工并攻丝状态和最终外形加工状态。",
        "source_kind": "observed_drawing",
        "subject_scope": "current_object",
        "allowed_values": null,
        "hit_criteria": "必须同时看到三类彼此独立且绑定当前棱柱板件或块件的原文标注：一处明确粗加工或粗铣；一处明确按工艺卡片精加工/精铣并攻丝；一处另行明确最终外形加工或铣外形。三类文字可分布在不同视图，但必须能确定各自约束的几何区域。",
        "not_hit_criteria": "完整检查后缺少上述任一独立阶段，或只有泛称加工、单次铣削、单独攻丝、普通尺寸/公差而没有三个被明确区分的加工状态时返回NOT_HIT。",
        "coverage_requirement": "检查整页全部视图上方、视图内部、工艺图说明、技术要求和局部引出文字；逐项记录粗加工、精加工/攻丝、最终外形三类文字及其所绑定视图。",
        "evidence_requirement": "分别逐字提供三类原文及页面区域；任一文字模糊、被裁切或无法确认绑定当前对象时返回UNABLE_TO_JUDGE。",
        "judgement_definition": "这只记录PDF明示的三个独立制造状态，不输出工艺路线，也不从物料编码、图号、名称或历史路线补齐阶段。只有三个阶段均被图面文字分别建立时才命中。"
      }
    },
    {
      "op": "upsert",
      "collection": "facts",
      "key": "critical_fit_and_geometric_tolerance_present",
      "value": {
        "label": "关键配合与基准形位公差组合",
        "fact_key": "critical_fit_and_geometric_tolerance_present",
        "reader_key": "geometry_dimension_reader",
        "value_type": "boolean",
        "description": "当前对象是否同时具有明确的配合/窄带尺寸公差和引用基准的形位公差。",
        "source_kind": "observed_drawing",
        "subject_scope": "current_object",
        "allowed_values": null,
        "hit_criteria": "必须同时满足：至少一个具体尺寸带配合代号或明确上下偏差形成的窄公差带；至少一个形位公差框引用明确基准字母。两者必须绑定当前对象的可识别几何要素。",
        "not_hit_criteria": "完整检查后只有未注公差、普通尺寸、单独配合尺寸、单独形位公差或没有基准引用时返回NOT_HIT。",
        "coverage_requirement": "检查全部尺寸、公差上下偏差、配合代号、形位公差框、基准符号及其引出对象；不得把表面粗糙度数值当作尺寸公差。",
        "evidence_requirement": "同时提供配合/上下偏差原文、形位公差框原文、基准字母及各自绑定的几何要素。任一关系不可读时返回UNABLE_TO_JUDGE。",
        "judgement_definition": "这是可验证的尺寸与几何控制组合事实，不是检验工序答案。图号、名称和历史检验记录不得参与判断。"
      }
    },
